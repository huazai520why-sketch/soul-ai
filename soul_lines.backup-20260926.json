      "text": "站一天 腿都不是自己的了",
      "cond": null,
      "used": []
    },
    {
      "id": 3,
      "cat": "状态型",
      "text": "刚洗完澡 躺下了",
      "cond": null,
      "used": []
    },
    {
      "id": 4,
      "cat": "状态型",
      "text": "夜班刚熬完 人还是飘的",
      "cond": null,
      "used": []
    },
    {
      "id": 5,
      "cat": "状态型",
      "text": "明天六点还得起",
      "cond": null,
      "used": []
    },
    {
      "id": 6,
      "cat": "状态型",
      "text": "食堂今天那菜 一言难尽",
      "cond": null,
      "used": []
    },
    {
      "id": 7,
      "cat": "状态型",
      "text": "车间吵一天 耳朵还嗡嗡的",
      "cond": null,
      "used": []
    },
    {
      "id": 8,
      "cat": "状态型",
      "text": "刚到家 饭都不想做",
      "cond": null,
      "used": []
    },
    {
      "id": 9,
      "cat": "状态型",
      "text": "今天加班到九点 人麻了",
      "cond": null,
      "used": []
    },
    {
      "id": 10,
      "cat": "状态型",
      "text": "倒班第一天 整个人是懵的",
      "cond": null,
      "used": []
    },
    {
      "id": 11,
      "cat": "状态型",
      "text": "中午就啃了两个包子",
      "cond": null,
      "used": []
    },
    {
      "id": 12,
      "cat": "状态型",
      "text": "手上全是机油味 洗了三遍",
      "cond": null,
      "used": []
    },
    {
      "id": 13,
      "cat": "状态型",
      "text": "周末就一天 还没睡够就过了",
      "cond": null,
      "used": []
    },
    {
      "id": 14,
      "cat": "状态型",
      "text": "今天流水线特别快 手跟不上",
      "cond": null,
      "used": []
    },
    {
      "id": 15,
      "cat": "状态型",
      "text": "刚吃完饭 瘫沙发上了",
      "cond": null,
      "used": []
    },
    {
      "id": 16,
      "cat": "状态型",
      "text": "手机快没电了 充电线还找不着",
      "cond": null,
      "used": []
    },
    {
      "id": 17,
      "cat": "状态型",
      "text": "今天三江这边下雨 路上堵惨了",
      "cond": null,
      "used": []
    },
    {
      "id": 18,
      "cat": "状态型",
      "text": "车停楼下懒得洗 一层灰",
      "cond": null,
      "used": []
    },
    {
      "id": 19,
      "cat": "状态型",
      "text": "明天上白班 但愿别加太久",
      "cond": null,
      "used": []
    },
    {
      "id": 20,
      "cat": "状态型",
      "text": "刚刷完抖音 一抬头十二点了",
      "cond": null,
      "used": []
    },
    {
      "id": 21,
      "cat": "状态型",
      "text": "今天币又跌了 我装死不看",
      "cond": null,
      "used": []
    },
    {
      "id": 22,
      "cat": "状态型",
      "text": "腰有点不行了 站久了就酸",
      "cond": null,
      "used": []
    },
    {
      "id": 23,
      "cat": "状态型",
      "text": "今天组长又催产量 烦得很",
      "cond": null,
      "used": []
    },
    {
      "id": 24,
      "cat": "状态型",
      "text": "刚跟我妈打完电话 又开始念叨",
      "cond": null,
      "used": []
    },
    {
      "id": 25,
      "cat": "状态型",
      "text": "一个人住 冰箱里就剩两瓶水",
      "cond": null,
      "used": []
    },
    {
      "id": 26,
      "cat": "具体好奇",
      "text": "你头像那只猫是你养的?",
      "cond": null,
      "used": []
    },
    {
      "id": 27,
      "cat": "具体好奇",
      "text": "你这名字是随手打的吧",
      "cond": null,
      "used": []
    },
    {
      "id": 28,
      "cat": "具体好奇",
      "text": "你也在重庆这边?",
      "cond": null,
      "used": []
    },
    {
      "id": 29,
      "cat": "具体好奇",
      "text": "你那边现在多少度",
      "cond": null,
      "used": []
    },
    {
      "id": 30,
      "cat": "具体好奇",
      "text": "你也上夜班?",
      "cond": null,
      "used": []
    },
    {
      "id": 31,
      "cat": "具体好奇",
      "text": "你平时几点睡",
      "cond": null,
      "used": []
    },
    {
      "id": 32,
      "cat": "具体好奇",
      "text": "你自己住还是跟家里",
      "cond": null,
      "used": []
    },
    {
      "id": 33,
      "cat": "具体好奇",
      "text": "你会做饭不",
      "cond": null,
      "used": []
    },
    {
      "id": 34,
      "cat": "具体好奇",
      "text": "你上班开车还是坐车",
      "cond": null,
      "used": []
    },
    {
      "id": 35,
      "cat": "具体好奇",
      "text": "你周末一般都干嘛",
      "cond": null,
      "used": []
    },
    {
      "id": 36,
      "cat": "具体好奇",
      "text": "你养宠物没",
      "cond": null,
