    },
    {
      "id": 37,
      "cat": "具体好奇",
      "text": "你这头像是自己拍的?",
      "cond": null,
      "used": []
    },
    {
      "id": 38,
      "cat": "具体好奇",
      "text": "你上班地方离家远不远",
      "cond": null,
      "used": []
    },
    {
      "id": 39,
      "cat": "具体好奇",
      "text": "你也是被朋友拉来玩的?",
      "cond": null,
      "used": []
    },
    {
      "id": 40,
      "cat": "具体好奇",
      "text": "你最近在追啥剧 我也来一部",
      "cond": null,
      "used": []
    },
    {
      "id": 41,
      "cat": "轻调侃",
      "text": "签名写这么凶 我有点不敢开口",
      "cond": null,
      "used": []
    },
    {
      "id": 42,
      "cat": "轻调侃",
      "text": "回这么快 是不是在等我",
      "cond": "对方秒回时",
      "used": []
    },
    {
      "id": 43,
      "cat": "轻调侃",
      "text": "你是不是把我当树洞了",
      "cond": "对方连着倒苦水时",
      "used": []
    },
    {
      "id": 44,
      "cat": "轻调侃",
      "text": "行 那我先认怂",
      "cond": null,
      "used": []
    },
    {
      "id": 45,
      "cat": "轻调侃",
      "text": "你这脾气 一听就是重庆的",
      "cond": "对方同城时",
      "used": []
    },
    {
      "id": 46,
      "cat": "轻调侃",
      "text": "说好的高冷呢",
      "cond": "对方话变多后",
      "used": []
    },
    {
      "id": 47,
      "cat": "轻调侃",
      "text": "你这句话我琢磨了半天",
      "cond": null,
      "used": []
    },
    {
      "id": 48,
      "cat": "轻调侃",
      "text": "好嘛 又被你将了一军",
      "cond": null,
      "used": []
    },
    {
      "id": 49,
      "cat": "轻调侃",
      "text": "你是真不给我留面子",
      "cond": null,
      "used": []
    },
    {
      "id": 50,
      "cat": "轻调侃",
      "text": "我这么老实 你舍得骗我?",
      "cond": "已有几轮对话",
      "used": []
    },
    {
      "id": 51,
      "cat": "轻调侃",
      "text": "行 我记住了 下次找你算账",
      "cond": null,
      "used": []
    },
    {
      "id": 52,
      "cat": "轻调侃",
      "text": "你这话说得 我竟无法反驳",
      "cond": null,
      "used": []
    },
