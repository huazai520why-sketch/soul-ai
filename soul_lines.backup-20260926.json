      "id": 53,
      "cat": "轻调侃",
      "text": "看来我得攒点词汇量了",
      "cond": null,
      "used": []
    },
    {
      "id": 54,
      "cat": "轻调侃",
      "text": "你是不是偷偷笑了",
      "cond": null,
      "used": []
    },
    {
      "id": 55,
      "cat": "轻调侃",
      "text": "被你拿捏了 行吧",
      "cond": null,
      "used": []
    },
