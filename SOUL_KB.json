  "commands": {
    "launch": "mumu-cli control -v 0 app launch --package cn.soulapp.android",
    "close": "mumu-cli control -v 0 app close --package cn.soulapp.android",
    "read_ui": "python E:\\soul\\soul_read.py",
    "read_pending": "python E:\\soul\\soul_im.py pending",
    "send": "python E:\\soul\\soul_reply.py \"昵称\" \"内容\"",
    "tap": "mumu-cli sh -v 0 -c \"input -d <display> tap X Y\"",
    "swipe": "mumu-cli sh -v 0 -c \"input -d <display> swipe X1 Y1 X2 Y2 300\"",
    "back": "mumu-cli sh -v 0 -c \"input keyevent 4\"",
    "input_text": "mumu-cli control -v 0 tool cmd -c input_text -t \"中文\"",
    "screenshot": "python E:\\soul\\winshot.py E:\\soul\\wshot.png"
  },
